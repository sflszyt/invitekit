{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "invitekit",
  "main": "src/worker.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-10-08",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "ENVIRONMENT": "production",
    "RSVP_ENABLED": "false",
    "PUBLIC_RSVP_ENABLED": "false",
    "PUBLIC_ORIGIN": "https://invite.example.com",
    "ADMIN_EMAILS": "",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": ""
  },
  "d1_databases": [{ "binding": "DB", "database_name": "invitekit", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
