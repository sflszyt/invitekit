{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "invitekit-local",
  "main": "src/worker.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-10-08",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "ENVIRONMENT": "local", "RSVP_ENABLED": "true" },
  "d1_databases": [{ "binding": "DB", "database_name": "invitekit-local", "database_id": "local-invitekit-db", "migrations_dir": "migrations" }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
